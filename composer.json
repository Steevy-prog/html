{
    "name": "archiva/backend",
    "description": "Archiva Backend API",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "ext-pdo": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "phpunit/php-code-coverage": "^9.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "backend/"
        },
        "classmap": [
            "backend/models/",
            "backend/controllers/",
            "backend/config/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage-report --coverage-clover coverage.xml",
        "test-coverage-text": "phpunit --coverage-text"
    }
}
